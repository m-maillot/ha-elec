# Copier en .env puis adapter. Lu par docker compose.

# Secret servant à dériver la clé de chiffrement des jetons (AES-256-GCM).
# Générer par exemple avec : openssl rand -base64 32
APP_SECRET=

# Port exposé sur l'hôte (le conteneur écoute toujours sur 3000).
PORT=3000

# Fuseau horaire de l'application.
TZ=Europe/Paris
